{
  "name": "shulkr",
  "version": "1.54.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:plugin": "cd packages/shulkr-core-plugin && ./gradlew build",
    "build:frontend": "cd packages/frontend && turbo build",
    "build:backend": "cd packages/backend && turbo build",
    "build:shared": "cd packages/shared && turbo build",
    "build:website": "cd packages/website && turbo build",
    "lint": "turbo lint",
    "fix": "eslint --fix . && prettier --check --write .",
    "test": "turbo test"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.7.4",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/js-yaml": "^4.0.9",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.10",
    "typescript": "^5",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "pnpm@11.0.8",
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "brace-expansion>balanced-match": "^4.0.2"
    }
  }
}
