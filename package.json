{
  "name": "shulkr",
  "version": "1.76.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:plugin": "cd packages/shulkr-core-plugin && ./gradlew build",
    "build:frontend": "cd packages/frontend && turbo build",
    "build:backend": "cd packages/backend && turbo build",
    "build:shared": "cd packages/shared && turbo build",
    "lint": "turbo lint",
    "fix": "eslint --fix . && prettier --check --write .",
    "test": "turbo test"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/js-yaml": "^4.0.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@11.0.8"
}
