{
  "name": "@shulkr/backend",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env --import=./src/env.ts src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit && eslint --fix src/ && prettier --check --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/lib-storage": "^3.1157.0",
    "@fastify/cookie": "^10",
    "@fastify/cors": "^10",
    "@fastify/helmet": "^12",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "@shulkr/shared": "workspace:*",
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/fastify": "3.53.0-rc.1",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "js-yaml": "^4.3.2",
    "mysql2": "^3.24.4",
    "otpauth": "^9.5.0",
    "pidusage": "^4.0.1",
    "pino": "^9",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/pidusage": "^2.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  }
}
